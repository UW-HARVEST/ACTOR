;\n354\t      blake512_update( S, padding, 888 - S->buflen );\n355\t    }\n356\t    else { /* NOT enough space, need 2 compressions */ \n357\t      S->t[0] -= 1024 - S->buflen; \n358\t      blake512_update( S, padding, 1024 - S->buflen );\n359\t      S->t[0] -= 888;\n360\t      blake512_update( S, padding+1, 888 );\n361\t      S->nullt = 1;\n362\t    }\n363\t    blake512_update( S, &zo, 8 );\n364\t    S->t[0] -= 8;\n365\t  }\n366\t  S->t[0] -= 128;\n367\t  blake512_update( S, msglen, 128 );    \n368\t\n369\t  U64TO8( digest + 0, S->h[0]);\n370\t  U64TO8( digest + 8, S->h[1]);\n371\t  U64TO8( digest +16, S->h[2]);\n372\t  U64TO8( digest +24, S->h[3]);\n373\t  U64TO8( digest +32, S->h[4]);\n374\t  U64TO8( digest +40, S->h[5]);\n375\t  U64TO8( digest +48, S->h[6]);\n376\t  U64TO8( digest +56, S->h[7]);\n377\t}\n378\t\n379\tvoid blake512_mgf1(unsigned char *out, unsigned long outlen,\n380\t\t\t   const unsigned char *in, unsigned long inlen)\n381\t{\n382\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n383\t    unsigned char outbuf[SPX_BLAKE512_OUTPUT_BYTES];\n384\t    unsigned long i;\n385\t\n386\t    memcpy(inbuf, in, inlen);\n387\t\n388\t    /* While we can fit in at least another full block of BLAKE512 output.. */\n389\t    for (i = 0; (i+1)*SPX_BLAKE512_OUTPUT_BYTES <= outlen; i++) {\n390\t        u32_to_bytes(inbuf + inlen, i);\n391\t        blake512(out, inbuf, inlen + 4);\n392\t        out += SPX_BLAKE512_OUTPUT_BYTES;\n393\t    }\n394\t    /* Until we cannot anymore, and we fill the remainder. */\n395\t    if (outlen > i*SPX_BLAKE512_OUTPUT_BYTES) {\n396\t        u32_to_bytes(inbuf + inlen, i);\n397\t        blake512(outbuf, inbuf, inlen + 4);\n398\t        memcpy(out, outbuf, outlen - i*SPX_BLAKE512_OUTPUT_BYTES);\n399\t    }\n400\t}\n401\t\n402\tint blake512( unsigned char *out, const unsigned char *in, unsigned long long inlen ) {\n403\t\n404\t  blakestate512 S;\n405\t  blake512_init( &S );\n406\t  blake512_update( &S, in, inlen*8 );\n407\t  blake512_final( &S, out )