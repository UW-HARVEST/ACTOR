4(kat_tr_ctx *ctx, unsigned long long x) {\n130\t  uint8_t le[8];\n131\t  size_t i;\n132\t  for (i = 0; i < 8; i++) {\n133\t    le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n134\t  }\n135\t\n136\t  uint8_t lenle[8];\n137\t  unsigned long long L = 8;\n138\t  for(i = 0; i < 8; i++) {\n139\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n140\t  }\n141\t\n142\t  haraka_S_inc_absorb(ctx->s, lenle, 8, &ctx->inner);\n143\t  haraka_S_inc_absorb(ctx->s, le, 8, &ctx->inner);\n144\t}\n145\t\n146\tstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n147\t  uint8_t lenle[8];\n148\t  unsigned long long L = (unsigned long long) len;\n149\t  size_t i;\n150\t  for(i = 0; i < 8; i++) {\n151\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n152\t  }\n153\t  haraka_S_inc_absorb(ctx->s, lenle, 8, &ctx->inner);\n154\t  if(len) {\n155\t    haraka_S_inc_absorb(ctx->s, buf, len, &ctx->inner);\n156\t  }\n157\t}\n158\t\n159\tstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n160\t  haraka_S_inc_finalize(ctx->s);\n161\t  haraka_S_inc_squeeze(out32, 32, ctx->s, &ctx->inner);\n162\t}\n163\t#elif SHA2_TR\n164\t#include \"../../lib/sha2/include/sha2.h\"\n165\t#if SPX_N >= 24\n166\t#define shaX_inc_init sha512_inc_init\n167\t#define shaX_inc_blocks sha512_inc_blocks\n168\t#define shaX_inc_finalize sha512_inc_finalize\n169\t#define shaX_state_len 72\n170\t#define shaX_block_bytes 128\n171\t#define shaX_output_bytes 64\n172\t#else\n173\t#define shaX_inc_init sha256_inc_init\n174\t#define shaX_inc_blocks sha256_inc_blocks\n175\t#define shaX_inc_finalize sha256_inc_finalize\n176\t#define shaX_state_len 40\n177\t#define shaX_block_bytes 64\n178\t#define shaX_output_bytes 32\n179\t#endif\n180\t\n181\ttypedef struct {\n182\t  uint8_t s[shaX_state_len];\n183\t} kat_tr_ctx;\n184\t\n185\tstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n186\t  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-SHA2\";\n187\t  uint8_t block[shaX_block_bytes];\n188\t  size_t i;\n189\t\n190\t  for (i = 0; i < sizeof tag - 1; ++i) {\n191\t      block[i] = tag[i];\n192\t  }\n193\t  for (i = sizeof tag - 1; i < shaX_block_bytes; ++i) {\n194\t      block[i] = 0;\n195\t  }\n196\t\n197\t  shaX_inc_init(ctx->s);\n198\t  shaX_inc_blocks(ctx->s, block, 1);\n199\t}\n200\t\n201\tstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char *label) {\n202\t  const uint8_t *p = (const uint8_t *)label;\n203\t  size_t n = 0; while(p[n]) n++;\n204\t  size_t block_count = (n + 1 + (shaX_block_bytes - 1)) / shaX_block_bytes;\n205\t\n206\t  size_t i;\n207\t  for(i = 0; i < block_count; ++i) {\n208\t    uint8_t block[shaX_block_bytes];\n209\t    size_t j;\n210\t\n211\t    for(j = 0; i * shaX_block_bytes + j < n && j < shaX_block_bytes; ++j) {\n212\t      block[j] = p[i * shaX_block_bytes + j];\n213\t    }\n214\t\n215\t    if(i * shaX_block_bytes + j == n && j < shaX_block_bytes) {\n216\t      block[j] = 0x00;\n217\t      ++j;\n218\t    }\n219\t\n220\t    for(; j < shaX_block_bytes; ++j) {\n221\t      block[j] = 0;\n222\t    }\n223\t\n224\t    shaX_inc_blocks(ctx->s, block, 1);\n225\t  }\n226\t}\n227\t\n228\tstatic inline void kat_tr_absorb_u64(kat_tr_ctx *ctx, unsigned long long x) {\n229\t  uint8_t block[shaX_block_bytes];\n230\t  uint8_t le[8];\n231\t  size_t i;\n232\t  for (i = 0; i < 8; i++) {\n233\t    le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n234\t  }\n235\t\n236\t  uint8_t lenle[8];\n237\t  unsigned long long L = 8;\n238\t  for(i = 0; i < 8; i++) {\n239\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n240\t  }\n241\t\n242\t  for (i = 0; i < 8; ++i) {\n243\t      block[i] = lenle[i];\n244\t  }\n245\t  for (i = 0; i < 8; ++i) {\n246\t      block[8+i] = le[i];\n247\t  }\n248\t  for (i = 16; i < shaX_block_bytes; ++i) {\n249\t      block[i] = 0;\n250\t  }\n251\t\n252\t  shaX_inc_blocks(ctx->s, block, 1);\n253\t}\n254\t\n255\tstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n256\t  uint8_t lenle[shaX_block_bytes] = {0};\n257\t  unsigned long long L = (unsigned long long) len;\n258\t  size_t i;\n259\t  for(i = 0; i < 8; i++) {\n260\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n261\t  }\n262\t  size_t block_count = (len + (shaX_block_bytes - 1)) / shaX_block_bytes;\n263\t  shaX_inc_blocks(ctx->s, lenle, 1);\n264\t\n265\t  if(len != 0) {\n266\t    for(i = 0; i < block_count; ++i) {\n267\t      uint8_t block[shaX_block_bytes];\n268\t      size_t j;\n269\t\n270\t      for(j = 0; i * shaX_block_bytes + j < len && j < shaX_block_bytes; ++j) {\n271\t        block[j] = buf[i * shaX_block_bytes + j];\n272\t      }\n273\t      for(; j < shaX_block_bytes; ++j) {\n274\t        block[j] = 0;\n275\t      }\n276\t\n277\t      shaX_inc_blocks(ctx->s, block, 1);\n278\t    }\n279\t  }\n280\t}\n281\t\n282\tstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n283\t  unsigned char outbuf[shaX_output_bytes] = {0};\n284\t  uint8_t final_block[shaX_block_bytes] = {0};\n285\t  shaX_inc_finalize(outbuf, ctx->s, final_block, 1);\n286\t  memcpy(out32, outbuf, 32);\n287\t}\n288\t#elif SHAKE_TR\n289\t#include \"../../lib/shake/include/fips202.h\"\n290\ttypedef struct {\n291\t  uint64_t s[26];\n292\t} kat_tr_ctx;\n293\t\n294\tstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n295\t  shake256_inc_init(ctx->s);\n296\t\n297\t  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-SHAKE\";\n298\t  shake256_inc_absorb(ctx->s, tag, sizeof tag - 1);\n299\t\n300\t  const uint8_t sep = 0x00;\n301\t  shake256_inc_absorb(ctx->s, &sep, 1);\n302\t}\n303\t\n304\tstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char *label) {\n305\t  const uint8_t *p = (const uint8_t *)label;\n306\t  size_t n = 0; while(p[n]) n++;\n307\t  shake256_inc_absorb(ctx->s, p, n);\n308\t\n309\t  const uint8_t sep = 0x00;\n310\t  shake256_inc_absorb(ctx->s, &sep, 1);\n311\t}\n312\t\n313\tstatic inline void kat_tr_absorb_u64(kat_tr_ctx *ctx, unsigned long long x) {\n314\t  uint8_t le[8];\n315\t  size_t i;